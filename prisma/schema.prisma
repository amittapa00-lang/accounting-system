generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money columns are DECIMAL(14,2): baht with exactly 2 decimals (satang).
// Quantities and unit prices keep 4 decimals; amounts are rounded with lib/money.ts.

model Customer {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  address        String?
  tel            String?
  taxId          String?
  branchType     String?
  branchNumber   String?
  contactName    String?
  email          String?
  note           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                  String              @id @default(cuid())
  poNumber            String              @unique
  plant               String?
  poDate              DateTime
  deliveryDate        DateTime?
  deliveryPlace       String?
  billPlacement       String?
  paymentTerm         String?
  quotationNumber     String?
  quotationDate       DateTime?
  contactName         String?
  contactPhone        String?
  contactMobile       String?
  acceptanceCondition String?
  note                String?
  /// DRAFT | CONFIRMED | COMPLETED | CANCELLED (see lib/labels.ts)
  status              String              @default("DRAFT")
  customerId          String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  invoices            Invoice[]
  customer            Customer            @relation(fields: [customerId], references: [id])
  items               PurchaseOrderItem[]

  @@index([customerId])
  @@index([poDate])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  /// row order; the printed number comes from lib/lines.ts (SUB lines are not numbered)
  itemNo          Int
  /// ITEM | HEADER | SUB (see lib/lines.ts)
  lineType        String        @default("ITEM")
  description     String
  quantity        Decimal       @db.Decimal(14, 4)
  unit            String?
  unitPrice       Decimal       @db.Decimal(14, 4)
  /// PERCENT: percentage (10 = 10%). AMOUNT: baht.
  discount        Decimal       @default(0) @db.Decimal(14, 4)
  discountType    String        @default("PERCENT")
  /// VAT rate in percent (7 = 7%)
  vat             Decimal       @default(0) @db.Decimal(5, 2)
  /// quantity x unitPrice - discount, rounded to satang
  amount          Decimal       @db.Decimal(14, 2)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  invoiceItems    InvoiceItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
}

model Invoice {
  id                      String        @id @default(cuid())
  /// IV2026/001 — shared by all sub-invoices of the same PO
  invoiceNumber           String
  /// 1, 2, 3 ... within invoiceNumber (one per billing of the PO)
  subNumber               Int           @default(1)
  /// TAX_INVOICE_DELIVERY | BILLING_INVOICE | RECEIPT (see lib/labels.ts)
  documentType            String
  invoiceDate             DateTime
  customerCodeSnapshot    String?
  customerNameSnapshot    String
  customerAddressSnapshot String?
  customerTaxIdSnapshot   String?
  shipToSnapshot          String?
  dueDate                 DateTime?
  paymentTerm             String?
  saleOrderNumber         String?
  saleName                String?
  entryBy                 String?
  purchaseOrderId         String
  note                    String?
  /// bill discount as entered: PERCENT (10 = 10%) or AMOUNT (baht)
  billDiscount            Decimal       @default(0) @db.Decimal(14, 4)
  billDiscountType        String        @default("AMOUNT")
  /// bill discount in baht, taken off before VAT
  billDiscountAmount      Decimal       @default(0) @db.Decimal(14, 2)
  /// after the bill discount
  subtotal                Decimal       @default(0) @db.Decimal(14, 2)
  vat                     Decimal       @default(0) @db.Decimal(14, 2)
  grandTotal              Decimal       @default(0) @db.Decimal(14, 2)
  /// DRAFT | ISSUED | PARTIAL | PAID | CANCELLED (see lib/labels.ts)
  status                  String        @default("DRAFT")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  purchaseOrder           PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  items                   InvoiceItem[]
  payments                Payment[]
  logs                    InvoiceLog[]

  @@unique([invoiceNumber, subNumber])
  @@index([purchaseOrderId])
  @@index([invoiceDate])
  @@index([status])
}

/// History of an invoice: who did what and when (see lib/invoice-log.ts)
model InvoiceLog {
  id        String   @id @default(cuid())
  invoiceId String
  /// CREATED | EDITED | BILLED | UNBILLED | PAID | UNPAID | PAYMENT | CANCELLED | STATUS
  action    String
  /// what changed, one line per change (Thai)
  detail    String?
  /// name of the signed-in user at the time
  userName  String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
}

model InvoiceItem {
  id                  String             @id @default(cuid())
  itemNo              Int
  /// ITEM | HEADER | SUB, copied from the PO line
  lineType            String             @default("ITEM")
  description         String
  quantity            Decimal            @db.Decimal(14, 4)
  unit                String?
  unitPrice           Decimal            @db.Decimal(14, 4)
  /// PERCENT: percentage (10 = 10%). AMOUNT: baht. Copied from the PO line.
  discount            Decimal            @default(0) @db.Decimal(14, 4)
  discountType        String             @default("PERCENT")
  amount              Decimal            @db.Decimal(14, 2)
  invoiceId           String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// the PO line billed by this line (to know how much of the PO is still unbilled)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([purchaseOrderItemId])
}

model Payment {
  id              String   @id @default(cuid())
  paymentDate     DateTime
  amount          Decimal  @db.Decimal(14, 2)
  /// TRANSFER | CASH | CHEQUE | CREDIT_CARD | OTHER (see lib/labels.ts)
  paymentMethod   String
  referenceNumber String?
  note            String?
  receivedBy      String?
  invoiceId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Restrict: an invoice that has received money cannot be deleted (keeps the audit trail)
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentDate])
}

model User {
  id String @id @default(cuid())

  username String  @unique
  email    String? @unique
  password String

  name String?

  /// ADMIN | USER
  role String @default("USER")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
